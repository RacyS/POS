<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Prompt:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Prompt', 'Sarabun', sans-serif;
        }
        
        .gallery-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .gallery-card:hover {
            transform: translateY(-8px) scale(1.02);
        }
        
        .gallery-card:hover img {
            transform: scale(1.1);
        }
        
        .gallery-card img {
            transition: transform 0.5s ease;
        }
        
        .card-shine {
            position: relative;
            overflow: hidden;
        }
        
        .card-shine::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
            z-index: 10;
            pointer-events: none;
        }
        
        .card-shine:hover::before {
            left: 100%;
        }
        
        .stagger-animation {
            opacity: 0;
            animation: fadeInUp 0.6s ease forwards;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .image-overlay {
            background: linear-gradient(180deg, transparent 0%, transparent 50%, rgba(0,0,0,0.7) 100%);
        }
        
        .glow-effect {
            box-shadow: 0 0 20px rgba(102, 126, 234, 0.15);
        }
        
        ::-webkit-scrollbar {
            width: 10px;
        }
        
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border-radius: 10px;
        }
    </style>
</head>
<body class="h-full overflow-auto bg-gradient-to-br from-slate-50 via-purple-50 to-pink-50">

<nav class="bg-black fixed w-full z-30 top-0 start-0 border-b border-gray-800 h-[72px]">
    <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
        <a class="flex items-center space-x-3 cursor-pointer hover:opacity-80 transition-opacity">
            <span class="self-center text-xl font-semibold whitespace-nowrap text-white">
                <span class="text-purple-500">ร้านจุ๊บ</span>อาหารตามสั่ง
            </span>
        </a>
    </div>
</nav>

<nav id="category-nav" class="fixed top-[72px] w-full z-20 bg-black/95 backdrop-blur-md border-b border-gray-800 shadow-md">
    <div class="max-w-screen-xl mx-auto px-4 py-3">
        <div class="flex overflow-x-auto gap-3 pb-1 md:justify-center no-scrollbar items-center">
            
            <button value="all" class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-medium bg-purple-600 text-white shadow-lg shadow-purple-900/40 transition-all transform hover:scale-105 active:scale-95">
                ทั้งหมด
            </button>

            <button value="kub" class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-medium text-gray-300 bg-gray-800/50 border border-gray-700 hover:bg-gray-700 hover:text-white hover:border-gray-500 transition-all active:scale-95">
                กับข้าว
            </button>
            
            <button value="noodle" class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-medium text-gray-300 bg-gray-800/50 border border-gray-700 hover:bg-gray-700 hover:text-white hover:border-gray-500 transition-all active:scale-95">
                เมนูเส้น
            </button>
            
            <button value="rice" class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-medium text-gray-300 bg-gray-800/50 border border-gray-700 hover:bg-gray-700 hover:text-white hover:border-gray-500 transition-all active:scale-95">
                อาหารจานเดียว
            </button>
            
            <button value="set" class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-medium text-gray-300 bg-gray-800/50 border border-gray-700 hover:bg-gray-700 hover:text-white hover:border-gray-500 transition-all active:scale-95">
                เซตสุดคุ้ม
            </button>
            
            <button value="tom" class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-medium text-gray-300 bg-gray-800/50 border border-gray-700 hover:bg-gray-700 hover:text-white hover:border-gray-500 transition-all active:scale-95">
                ต้มยำ/แกง
            </button>
            
            <button value="yom" class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-medium text-gray-300 bg-gray-800/50 border border-gray-700 hover:bg-gray-700 hover:text-white hover:border-gray-500 transition-all active:scale-95">
                ยำรสเด็ด
            </button>
        </div>
    </div>
</nav> <br> <br>
    <div id="app-container" class="min-h-full w-full px-4 md:px-8 py-24">
        <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 max-w-7xl mx-auto"></div>
    </div>
    
    <script src="/javascripts/Menu.js"></script>
    <script>
        const galleryContainer = document.getElementById('gallery');

        function renderMenus(data) {
            galleryContainer.innerHTML = '';
            data.forEach((menu, index) => {
                const card = document.createElement('div');
                card.className = 'gallery-card card-shine bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl glow-effect stagger-animation';
                card.style.animationDelay = `${(index % 12) * 0.05}s`;

                card.innerHTML = ` 
                    <div class="relative overflow-hidden"> 
                        <img 
                            src="${menu.image}" 
                            alt="${menu.name}"
                            class="w-full h-56 object-cover"
                            loading="lazy"
                            onerror="this.onerror=null; this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22><rect fill=%22%23f3e8ff%22 width=%22400%22 height=%22300%22/><text x=%22200%22 y=%22150%22 text-anchor=%22middle%22 font-size=%2248%22>🍽️</text></svg>';"
                        >
                    </div>
                    <div class="p-4 text-center">
                        <h3 class="text-lg font-semibold text-gray-800">${menu.name}</h3>
                    </div>
                `;
                galleryContainer.appendChild(card);
            });
        }

        const categories = document.querySelectorAll('#category-nav button');
        categories.forEach(btn => {
            btn.addEventListener('click', function () {
                categories.forEach(b => {
                    b.classList.remove('bg-purple-600', 'text-white', 'shadow-lg', 'shadow-purple-900/40');
                    b.classList.add('text-gray-300', 'bg-gray-800/50', 'border', 'border-gray-700');
                });

                this.classList.remove('text-gray-300', 'bg-gray-800/50', 'border', 'border-gray-700');
                this.classList.add('bg-purple-600', 'text-white', 'shadow-lg', 'shadow-purple-900/40');

                const value = this.value;
                if (value === "all") {
                    renderMenus(menuall);
                } else {
                    const filtered = menuall.filter(menu => menu.category === value);
                    renderMenus(filtered);
                }
            });
        });

        renderMenus(menuall);
    </script>

</body>
</html>