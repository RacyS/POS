    </svg>
    <span class="text-sm">เพิ่มเพื่อน</span>
</a>

<!-- ===== ORDER SUCCESS TOAST ===== -->
<div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden">
    <div class="bg-green-600 text-white px-6 py-3 rounded-2xl shadow-xl flex items-center gap-2 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <span id="toast-msg">สั่งอาหารเรียบร้อย!</span>
    </div>
</div>

<script src="/javascripts/Menu.js"></script>
<script>
// ============================================================
// CATEGORY LABELS & COLORS
// ============================================================
const catLabel = { kub:'กับข้าว', noodle:'เมนูเส้น', rice:'จานเดียว', set:'เซต', tom:'ต้มยำ/แกง', yom:'ยำ', rap:'ยำ' };
const catColor  = {
    kub:'bg-orange-100 text-orange-700',
    noodle:'bg-yellow-100 text-yellow-700',
    rice:'bg-green-100 text-green-700',
    set:'bg-blue-100 text-blue-700',
    tom:'bg-red-100 text-red-700',
    yom:'bg-pink-100 text-pink-700',
    rap:'bg-pink-100 text-pink-700'
};

// ============================================================
// STATE
// ============================================================
let cart = {}; // { menuId: { menu, qty } }
let activeCategory = 'all';
let searchQuery = '';

// ============================================================
// RENDER GALLERY
// ============================================================
const gallery = document.getElementById('gallery');
const emptyState = document.getElementById('empty-state');
const resultCount = document.getElementById('result-count');

function getFilteredMenus() {
    return menuall.filter(m => {
        const matchCat = activeCategory === 'all' || m.category === activeCategory;
        const matchSearch = m.name.toLowerCase().includes(searchQuery.toLowerCase());
        return matchCat && matchSearch;
    });
}

function renderMenus() {
    const data = getFilteredMenus();
    gallery.innerHTML = '';

    if (data.length === 0) {
        emptyState.classList.remove('hidden');
        emptyState.classList.add('flex');
        resultCount.textContent = '';
        return;
    }
    emptyState.classList.add('hidden');
    emptyState.classList.remove('flex');
    resultCount.textContent = `แสดง ${data.length} เมนู`;

    data.forEach((menu, index) => {
        const inCart = cart[menu.id];
        const qty = inCart ? inCart.qty : 0;

        const card = document.createElement('div');
        card.className = 'gallery-card bg-white rounded-2xl overflow-hidden shadow-md stagger-animation flex flex-col';
        card.style.animationDelay = `${(index % 20) * 0.04}s`;
        card.dataset.id = menu.id;

        card.innerHTML = `
            <div class="relative overflow-hidden bg-gray-100">
                <img
                    src="${menu.image}"
                    alt="${menu.name}"
                    class="w-full h-40 object-cover"
                    loading="lazy"
                    onerror="this.onerror=null;this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 400 300%22><rect fill=%22%23f3e8ff%22 width=%22400%22 height=%22300%22/><text x=%22200%22 y=%22160%22 text-anchor=%22middle%22 font-size=%2264%22>🍽️</text></svg>';"
                >
                <span class="absolute top-2 left-2 text-xs font-medium px-2 py-0.5 rounded-full ${catColor[menu.category] || 'bg-gray-100 text-gray-600'}">
                    ${catLabel[menu.category] || menu.category}
                </span>
            </div>
            <div class="p-3 flex flex-col flex-1 gap-1">
                <h3 class="text-sm font-semibold text-gray-800 leading-tight line-clamp-2 flex-1">${menu.name}</h3>
                <div class="flex items-center justify-end mt-2">
                    ${qty === 0
                        ? `<button onclick="addToCart(${menu.id})" class="add-btn bg-purple-600 hover:bg-purple-700 active:scale-95 text-white text-xs font-bold px-3 py-1.5 rounded-full transition-all shadow">+ เพิ่ม</button>`
                        : `<div class="flex items-center gap-1">
                               <button onclick="decreaseQty(${menu.id})" class="qty-btn bg-red-100 text-red-600 hover:bg-red-200">−</button>
                               <span class="w-6 text-center text-sm font-bold text-gray-800">${qty}</span>
                               <button onclick="increaseQty(${menu.id})" class="qty-btn bg-purple-100 text-purple-600 hover:bg-purple-200">+</button>
                           </div>`
                    }
                </div>
            </div>
        `;
        gallery.appendChild(card);
    });
}

// ============================================================
// CART LOGIC
// ============================================================
function addToCart(id) {
    const menu = menuall.find(m => m.id === id);
    if (!menu) return;
    if (cart[id]) {
        cart[id].qty++;
    } else {
        cart[id] = { menu, qty: 1 };
    }
    renderMenus();
    updateCartUI();
    animateBadge();
}

function increaseQty(id) {
    if (cart[id]) { cart[id].qty++; renderMenus(); updateCartUI(); animateBadge(); }
}

function decreaseQty(id) {
    if (!cart[id]) return;
    cart[id].qty--;
    if (cart[id].qty <= 0) delete cart[id];
    renderMenus();
    updateCartUI();
}

function removeFromCart(id) {
    delete cart[id];
    renderMenus();
    updateCartUI();
}

function clearCart() {
    cart = {};
    renderMenus();
    updateCartUI();
}

function updateCartUI() {
    const items = Object.values(cart);
    const totalQty = items.reduce((s, i) => s + i.qty, 0);

    // Badge
    const badge = document.getElementById('cart-count');
    if (totalQty > 0) {
        badge.textContent = totalQty > 99 ? '99+' : totalQty;
        badge.classList.remove('hidden');
    } else {
        badge.classList.add('hidden');
    }

    // Drawer count
    document.getElementById('drawer-count').textContent = `${totalQty} รายการ`;

    // Items list
    const listEl = document.getElementById('cart-items');
    const emptyEl = document.getElementById('cart-empty');
    const footerEl = document.getElementById('cart-footer');

    if (items.length === 0) {
        listEl.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        footerEl.classList.add('hidden');
    } else {
        listEl.classList.remove('hidden');
        emptyEl.classList.add('hidden');
        footerEl.classList.remove('hidden');
        listEl.innerHTML = items.map(item => `
            <div class="flex gap-3 bg-gray-50 rounded-xl p-3">
                <img src="${item.menu.image}" alt="${item.menu.name}" class="w-16 h-16 rounded-lg object-cover bg-gray-200 flex-shrink-0"
                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect fill=%22%23f3e8ff%22 width=%2264%22 height=%2264%22/><text x=%2232%22 y=%2240%22 text-anchor=%22middle%22 font-size=%2228%22>🍽️</text></svg>'">
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-800 line-clamp-2 leading-tight">${item.menu.name}</p>
                    <p class="text-gray-500 text-sm mt-1">จำนวน ${item.qty} รายการ</p>
                    <div class="flex items-center gap-2 mt-2">
                        <button onclick="decreaseQty(${item.menu.id})" class="qty-btn bg-red-100 text-red-600 hover:bg-red-200">−</button>
                        <span class="w-6 text-center text-sm font-bold">${item.qty}</span>
                        <button onclick="increaseQty(${item.menu.id})" class="qty-btn bg-purple-100 text-purple-600 hover:bg-purple-200">+</button>
                        <button onclick="removeFromCart(${item.menu.id})" class="ml-auto text-gray-400 hover:text-red-500 transition-colors p-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        `).join('');
    }

    document.getElementById('cart-qty-total').textContent = `${totalQty} รายการ`;
}

function animateBadge() {
    const badge = document.getElementById('cart-count');
    badge.classList.remove('badge-bounce');
    void badge.offsetWidth;
    badge.classList.add('badge-bounce');
}

// ============================================================
// CART DRAWER
// ============================================================
function openCart() {
    document.getElementById('cart-drawer').classList.add('open');
    document.getElementById('cart-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeCart() {
    document.getElementById('cart-drawer').classList.remove('open');
    document.getElementById('cart-overlay').classList.remove('open');
    document.body.style.overflow = '';
}
document.getElementById('cart-btn').addEventListener('click', openCart);

// ============================================================
// CONFIRM ORDER
// ============================================================
function confirmOrder() {
    if (Object.keys(cart).length === 0) return;
    closeCart();
    clearCart();
    showToast('สั่งอาหารเรียบร้อยแล้ว! 🎉');
}

function showToast(msg) {
    const toast = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3000);
}

// ============================================================
// CATEGORY FILTER
// ============================================================
document.querySelectorAll('.cat-btn').forEach(btn => {
    btn.addEventListener('click', function () {
        document.querySelectorAll('.cat-btn').forEach(b => {
            b.classList.remove('active');
            b.classList.add('text-gray-300', 'bg-gray-800/60', 'border-gray-700');
        });
        this.classList.add('active');
        this.classList.remove('text-gray-300', 'bg-gray-800/60', 'border-gray-700');
        activeCategory = this.dataset.cat;
        renderMenus();
    });
});

// ============================================================
// SEARCH
// ============================================================
function onSearch(e) {
    searchQuery = e.target.value;
    // sync both inputs
    document.getElementById('search-input').value = searchQuery;
    document.getElementById('search-input-mobile').value = searchQuery;
    renderMenus();
}
document.getElementById('search-input').addEventListener('input', onSearch);
document.getElementById('search-input-mobile').addEventListener('input', onSearch);

// ============================================================
// INIT
// ============================================================
updateCartUI();
renderMenus();
</script>
</body>
</html>