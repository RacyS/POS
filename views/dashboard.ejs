<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>เมนูอาหาร - ร้านจุ๊บ</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com/3.4.17"></script>
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&family=Prompt:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Prompt', 'Sarabun', sans-serif; }

        .gallery-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .gallery-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }
        .gallery-card img {
            transition: transform 0.4s ease;
        }
        .gallery-card:hover img {
            transform: scale(1.08);
        }

        .stagger-animation {
            opacity: 0;
            animation: fadeInUp 0.5s ease forwards;
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Cart drawer */
        #cart-drawer {
            transform: translateX(100%);
            transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #cart-drawer.open {
            transform: translateX(0);
        }
        #cart-overlay {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.35s ease;
        }
        #cart-overlay.open {
            opacity: 1;
            pointer-events: all;
        }

        /* Qty controls */
        .qty-btn {
            width: 28px; height: 28px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 16px; font-weight: 700;
            cursor: pointer; transition: all 0.15s;
            user-select: none;
        }
        .qty-btn:hover { filter: brightness(1.15); transform: scale(1.1); }
        .qty-btn:active { transform: scale(0.95); }

        /* Category active pill */
        .cat-btn.active {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 15px rgba(124,58,237,0.4);
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #9333ea; border-radius: 10px; }

        .badge-bounce {
            animation: bounce-once 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97);
        }
        @keyframes bounce-once {
            0%,100% { transform: scale(1); }
            40%      { transform: scale(1.4); }
            70%      { transform: scale(0.9); }
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* LINE OA button */
        .line-fab {
            background: #06C755;
            transition: all 0.2s ease;
        }
        .line-fab:hover {
            background: #05b34d;
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(6,199,85,0.45);
        }
        .line-fab:active { transform: scale(0.95); }

        @keyframes line-pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(6,199,85,0.5); }
            50%       { box-shadow: 0 0 0 10px rgba(6,199,85,0); }
        }
        .line-pulse { animation: line-pulse 2.5s ease-in-out infinite; }
    </style>
</head>
<body class="h-full overflow-auto bg-gradient-to-br from-slate-50 via-purple-50 to-pink-50">

<!-- ===== NAVBAR ===== -->
<nav class="bg-black fixed w-full z-30 top-0 border-b border-gray-800 h-[68px]">
    <div class="max-w-screen-xl flex items-center justify-between mx-auto px-4 h-full">
        <!-- Brand -->
        <a class="flex items-center space-x-2 cursor-pointer hover:opacity-80 transition-opacity">
            <span class="text-xl font-bold text-white">
                <span class="text-purple-400">ร้านจุ๊บ</span>อาหารตามสั่ง
            </span>
        </a>

        <!-- Search + User + Cart -->
        <div class="flex items-center gap-3">
            <!-- Search bar (desktop) -->
            <div class="relative hidden md:block">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                    </svg>
                </span>
                <input id="search-input" type="text"
                    class="block w-60 pl-9 pr-4 py-2 bg-white/8 border border-gray-700 text-white text-sm rounded-full focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none placeholder:text-gray-500 transition-all"
                    placeholder="ค้นหาเมนู...">
            </div>

            <!-- User -->
            <div class="flex items-center gap-2 cursor-pointer hover:bg-white/5 px-3 py-1 rounded-full transition-colors">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-600 to-blue-500 flex items-center justify-center text-white font-bold text-sm shadow-lg">
                    <%= (typeof userName !== 'undefined') ? userName.charAt(0).toUpperCase() : 'U' %>
                </div>
                <span class="hidden md:block text-gray-300 text-sm font-medium">
                    <%= (typeof userName !== 'undefined') ? userName : 'User' %>
                </span>
            </div>

            <!-- Cart button -->
            <button id="cart-btn" class="relative flex items-center gap-2 bg-purple-600 hover:bg-purple-700 active:scale-95 text-white px-4 py-2 rounded-full transition-all font-medium text-sm shadow-lg shadow-purple-900/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 9m5-9v9m4-9v9m5-9l2 9"/>
                </svg>
                <span class="hidden sm:inline">ตะกร้า</span>
                <span id="cart-count" class="hidden absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
            </button>
        </div>
    </div>
</nav>

<!-- ===== CATEGORY NAV ===== -->
<nav id="category-nav" class="fixed top-[68px] w-full z-20 bg-black/95 backdrop-blur-md border-b border-gray-800">
    <div class="max-w-screen-xl mx-auto px-4 py-2.5">
        <!-- Mobile search -->
        <div class="block md:hidden mb-2">
            <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                    </svg>
                </span>
                <input id="search-input-mobile" type="text"
                    class="block w-full pl-9 pr-4 py-2 bg-white/8 border border-gray-700 text-white text-sm rounded-full focus:ring-2 focus:ring-purple-500 outline-none placeholder:text-gray-500"
                    placeholder="ค้นหาเมนู...">
            </div>
        </div>
        <div class="flex overflow-x-auto gap-2 pb-1 no-scrollbar">
            <button data-cat="all" class="cat-btn active whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium border border-transparent transition-all active:scale-95">ทั้งหมด</button>
            <button data-cat="kub"    class="cat-btn whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium text-gray-300 bg-gray-800/60 border border-gray-700 hover:bg-gray-700 hover:text-white transition-all active:scale-95">กับข้าว</button>
            <button data-cat="noodle" class="cat-btn whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium text-gray-300 bg-gray-800/60 border border-gray-700 hover:bg-gray-700 hover:text-white transition-all active:scale-95">เมนูเส้น</button>
            <button data-cat="rice"   class="cat-btn whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium text-gray-300 bg-gray-800/60 border border-gray-700 hover:bg-gray-700 hover:text-white transition-all active:scale-95">อาหารจานเดียว</button>
            <button data-cat="set"    class="cat-btn whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium text-gray-300 bg-gray-800/60 border border-gray-700 hover:bg-gray-700 hover:text-white transition-all active:scale-95">เซตสุดคุ้ม</button>
            <button data-cat="tom"    class="cat-btn whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium text-gray-300 bg-gray-800/60 border border-gray-700 hover:bg-gray-700 hover:text-white transition-all active:scale-95">ต้มยำ/แกง</button>
            <button data-cat="yom"    class="cat-btn whitespace-nowrap px-4 py-1.5 rounded-full text-sm font-medium text-gray-300 bg-gray-800/60 border border-gray-700 hover:bg-gray-700 hover:text-white transition-all active:scale-95">ยำรสเด็ด</button>
        </div>
    </div>
</nav>

<!-- ===== MAIN CONTENT ===== -->
<div id="app-container" class="min-h-screen w-full px-4 md:px-8 pt-[148px] pb-10">
    <!-- LINE OA banner -->
    <div class="max-w-7xl mx-auto mb-5">
        <a href="https://lin.ee/oxchDFJ" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-3 bg-white border border-green-200 rounded-2xl px-5 py-3.5 shadow-sm hover:shadow-md hover:border-green-400 transition-all group">
            <!-- LINE logo -->
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background:#06C755">
                <svg viewBox="0 0 24 24" class="w-6 h-6 fill-white" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19.365 9.89c.50 0 .907.41.907.91s-.406.91-.907.91h-2.44v1.55h2.44c.50 0 .907.41.907.91s-.406.91-.907.91H16.02a.908.908 0 0 1-.907-.91V9.89c0-.5.406-.91.907-.91h3.345zm-13.73 0c.5 0 .908.41.908.91v3.372L9.14 9.995a.91.91 0 0 1 .803-.106c.277.1.465.36.465.658v4.285c0 .5-.407.91-.908.91s-.908-.41-.908-.91v-2.374l-2.578 3.177A.908.908 0 0 1 4.727 15a.908.908 0 0 1-.908-.91V9.89c0-.5.407-.91.908-.91zm3.64 0c.5 0 .907.41.907.91v4.292c0 .5-.407.91-.908.91-.5 0-.907-.41-.907-.91V10.8c0-.5.407-.91.908-.91zm3.42 0c.5 0 .907.41.907.91v4.292c0 .5-.407.91-.907.91a.908.908 0 0 1-.908-.91V10.8c0-.5.407-.91.908-.91zM12 2C6.477 2 2 6.037 2 11c0 2.818 1.36 5.326 3.487 6.985.192.148.252.4.148.612l-.654 2.384a.365.365 0 0 0 .518.426l2.741-1.453a.37.37 0 0 1 .312-.02C9.17 20.3 10.568 20.5 12 20.5c5.523 0 10-4.037 10-9s-4.477-9-10-9z"/>
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="font-bold text-gray-800 text-sm group-hover:text-green-700 transition-colors">เพิ่มเพื่อนกับเรา LINE OA</p>
                <p class="text-gray-500 text-xs mt-0.5">รับโปรโมชัน ข่าวสาร และสั่งอาหารผ่าน LINE</p>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0 text-white text-sm font-bold px-4 py-2 rounded-full transition-all" style="background:#06C755">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-white" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 11H7.83l4.88-4.88c.39-.39.39-1.03 0-1.42-.39-.39-1.02-.39-1.41 0l-6.59 6.59c-.39.39-.39 1.02 0 1.41l6.59 6.59c.39.39 1.02.39 1.41 0 .39-.39.39-1.02 0-1.41L7.83 13H19c.55 0 1-.45 1-1s-.45-1-1-1z"/>
                </svg>
                เพิ่มเพื่อน
            </div>
        </a>
    </div>

    <!-- Result count -->
    <p id="result-count" class="max-w-7xl mx-auto text-gray-500 text-sm mb-4"></p>
    <!-- Grid -->
    <div id="gallery" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 max-w-7xl mx-auto"></div>
    <!-- Empty state -->
    <div id="empty-state" class="hidden flex-col items-center justify-center py-24 text-center max-w-7xl mx-auto">
        <div class="text-6xl mb-4">🔍</div>
        <p class="text-gray-500 text-lg font-medium">ไม่พบเมนูที่ค้นหา</p>
        <p class="text-gray-400 text-sm mt-1">ลองค้นหาด้วยคำอื่น หรือเลือกหมวดหมู่อื่น</p>
    </div>
</div>

<!-- ===== CART OVERLAY ===== -->
<div id="cart-overlay" class="fixed inset-0 bg-black/50 z-40 backdrop-blur-sm" onclick="closeCart()"></div>

<!-- ===== CART DRAWER ===== -->
<div id="cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[400px] bg-white z-50 flex flex-col shadow-2xl">
    <!-- Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b bg-gradient-to-r from-purple-600 to-purple-700">
        <div class="flex items-center gap-2 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 9m5-9v9m4-9v9m5-9l2 9"/>
            </svg>
            <span class="font-bold text-lg">ตะกร้าสินค้า</span>
            <span id="drawer-count" class="bg-white/20 text-white text-xs px-2 py-0.5 rounded-full">0 รายการ</span>
        </div>
        <button onclick="closeCart()" class="text-white/80 hover:text-white hover:bg-white/10 p-1.5 rounded-lg transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <!-- Cart items list -->
    <div id="cart-items" class="flex-1 overflow-y-auto px-4 py-3 space-y-3"></div>

    <!-- Empty cart -->
    <div id="cart-empty" class="flex-1 flex flex-col items-center justify-center text-center px-8 py-12">
        <div class="text-6xl mb-4">🛒</div>
        <p class="text-gray-500 font-medium text-lg">ยังไม่มีรายการ</p>
        <p class="text-gray-400 text-sm mt-1">เพิ่มเมนูที่คุณต้องการลงในตะกร้า</p>
    </div>

    <!-- Footer summary -->
    <div id="cart-footer" class="hidden border-t bg-gray-50 px-5 py-4 space-y-3">
        <div class="flex justify-between text-sm text-gray-500">
            <span>รวมทั้งหมด</span>
            <span id="cart-qty-total">0 รายการ</span>
        </div>
        <button onclick="confirmOrder()" class="w-full bg-gradient-to-r from-purple-600 to-purple-700 hover:from-purple-700 hover:to-purple-800 active:scale-[0.98] text-white font-bold py-3 rounded-xl transition-all shadow-lg shadow-purple-900/25 flex items-center justify-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            ยืนยันคำสั่งซื้อ
        </button>
        <button onclick="clearCart()" class="w-full bg-gray-100 hover:bg-gray-200 active:scale-[0.98] text-gray-600 font-medium py-2 rounded-xl transition-all text-sm">
            ล้างตะกร้า
        </button>
    </div>
</div>

<!-- ===== LINE OA FLOATING BUTTON ===== -->
<a href="https://lin.ee/oxchDFJ" target="_blank" rel="noopener noreferrer"
   class="line-fab line-pulse fixed bottom-6 left-6 z-40 flex items-center gap-2 text-white font-bold px-4 py-3 rounded-full shadow-xl">
    <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white flex-shrink-0" xmlns="http://www.w3.org/2000/svg">
